stages:
  - lint
  - test

default:
  image: golang:{{ .Values.goVersion | default "1.26" }}
  interruptible: true

workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

lint:
  stage: lint
  script:
    - go vet ./...

test:
  stage: test
  script:
    - go test -race ./...
