//! {{ .Values.summary | default "What this does, in one line" }}

const std = @import("std");

pub const Error = error{EmptyValue};

/// Returns `value` as this program sees it.
pub fn run(value: []const u8) Error![]const u8 {
    if (value.len == 0) return Error.EmptyValue;
    return value;
}

pub fn main() !void {
    var arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
    defer arena.deinit();

    const args = try std.process.argsAlloc(arena.allocator());
    if (args.len < 2) {
        std.debug.print("Usage: {{ .Name }} <value>\n", .{});
        std.process.exit(64);
    }

    const out = try run(args[1]);
    var stdout = std.fs.File.stdout().writer(&.{});
    try stdout.interface.print("{s}\n", .{out});
}

test "run returns its argument" {
    try std.testing.expectEqualStrings("value", try run("value"));
}

test "run refuses an empty value" {
    try std.testing.expectError(Error.EmptyValue, run(""));
}
