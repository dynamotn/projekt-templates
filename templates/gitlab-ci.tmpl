stages:
  - lint
  - test

default:
  image: {{ .Values.image | default "alpine:3.22" }}
  interruptible: true

workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH

lint:
  stage: lint
  script:
    - {{ .Values.lint | default "make lint" }}

test:
  stage: test
  script:
    - {{ .Values.test | default "make test" }}
