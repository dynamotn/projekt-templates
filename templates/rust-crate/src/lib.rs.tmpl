/// Returns `value` as this crate sees it.
///
/// # Errors
///
/// Returns an error when `value` is empty.
pub fn run(value: &str) -> Result<String, Error> {
    if value.is_empty() {
        return Err(Error::Empty);
    }
    Ok(value.to_owned())
}

/// Everything this crate can fail with.
#[derive(Debug, PartialEq, Eq)]
pub enum Error {
    /// The value was empty.
    Empty,
}

impl std::fmt::Display for Error {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Self::Empty => write!(f, "value must not be empty"),
        }
    }
}

impl std::error::Error for Error {}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn run_returns_its_argument() {
        assert_eq!(run("value"), Ok("value".to_owned()));
    }

    #[test]
    fn run_refuses_an_empty_value() {
        assert_eq!(run(""), Err(Error::Empty));
    }
}
