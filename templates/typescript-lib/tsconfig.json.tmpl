{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"{{ if eq .Values.runtime "browser" }}, "DOM"{{ end }}],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["src", "tests"]
}
