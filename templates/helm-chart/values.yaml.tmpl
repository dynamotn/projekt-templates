replicaCount: 1

image:
  repository: <% .Values.image | default "nginx" %>
  tag: "<% .Values.tag | default "latest" %>"
  pullPolicy: IfNotPresent

service:
  type: ClusterIP
  port: <% .Values.port | default 8080 %>

resources:
  requests:
    cpu: 10m
    memory: 32Mi
  limits:
    memory: 128Mi

podSecurityContext:
  runAsNonRoot: true
  runAsUser: 1000

nodeSelector: {}
tolerations: []
affinity: {}
