.DEFAULT_GOAL := help
SHELL := /usr/bin/env bash

.PHONY: help
help: ## Show this help
	@grep -hE '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) \
		| awk 'BEGIN {FS = ":.*?## "} {printf "  \033[36m%-16s\033[0m %s\n", $$1, $$2}'

{{- range .Values.targets }}

.PHONY: {{ .name }}
{{ .name }}: ## {{ .help }}
	{{ .run }}
{{- end }}

.PHONY: lint
lint: ## Run the linters
	{{ .Values.lint | default "prek run --all-files" }}

.PHONY: test
test: ## Run the tests
	{{ .Values.test | default "echo 'no tests yet'" }}

.PHONY: clean
clean: ## Remove build output
	rm -rf {{ .Values.buildDir | default "dist" }}
