variable "name" {
  description = "Name every resource of this module is derived from."
  type        = string

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{2,62}$", var.name))
    error_message = "name must be lowercase, start with a letter and be 3-63 characters."
  }
}

variable "tags" {
  description = "Tags applied to every resource that takes them."
  type        = map(string)
  default     = {}
}

variable "enabled" {
  description = "Create the resources. False leaves the module inert, which is how a caller turns it off without removing the block."
  type        = bool
  default     = true
}
