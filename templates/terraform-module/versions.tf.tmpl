terraform {
  required_version = ">= {{ .Values.terraformVersion | default "1.9" }}"

  required_providers {
{{- if eq .Values.provider "aws" }}
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
{{- else if eq .Values.provider "azurerm" }}
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
{{- else if eq .Values.provider "google" }}
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
{{- else }}
    null = {
      source  = "hashicorp/null"
      version = "~> 3.0"
    }
{{- end }}
  }
}
