# {{ .Values.domain | default .Name }} — {{ .Values.summary | default "what this site serves" }}

upstream {{ .Name | replace "-" "_" }} {
    server {{ .Values.upstream | default "127.0.0.1:8080" }};
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ .Values.domain | default .Name }};

    # Everything else is https; this block exists only to say so.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ .Values.domain | default .Name }};

    ssl_certificate     /etc/letsencrypt/live/{{ .Values.domain | default .Name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ .Values.domain | default .Name }}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    access_log /var/log/nginx/{{ .Name }}.access.log;
    error_log  /var/log/nginx/{{ .Name }}.error.log;

    client_max_body_size {{ .Values.maxBody | default "16m" }};

    location / {
        proxy_pass http://{{ .Name | replace "-" "_" }};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
    }
}
